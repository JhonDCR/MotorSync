# Copiar a .env (no se versiona). Valores solo para desarrollo local: nunca los uses fuera de tu máquina.

# Superusuario del contenedor de PostgreSQL (docker-compose). Solo lo usa `npm run db:bootstrap`.
POSTGRES_USER=motorsync
POSTGRES_PASSWORD=motorsync_dev
POSTGRES_DB=motorsync
POSTGRES_PORT=5432

# Conexiones del backend (research R2): admin solo para el bootstrap, migrator para migraciones
# y fixtures de prueba, app (sin BYPASSRLS) para la API.
DATABASE_ADMIN_URL=postgresql://motorsync:motorsync_dev@localhost:5432/motorsync
DATABASE_MIGRATOR_URL=postgresql://motorsync_migrator:migrator_dev@localhost:5432/motorsync
DATABASE_URL=postgresql://motorsync_app:app_dev@localhost:5432/motorsync

# Contraseñas que el bootstrap asigna a los roles (deben coincidir con las URLs de arriba).
DB_MIGRATOR_PASSWORD=migrator_dev
DB_APP_PASSWORD=app_dev

# Firma de los JWT (HS256, mínimo 32 caracteres). Solo para local: en CI se genera en cada ejecución.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Firma de los JWT del panel de soporte (HS256, mínimo 32 caracteres). Cambiar; distinto de
# JWT_SECRET; la API no arranca sin ella.
SUPPORT_JWT_SECRET=dev-only-support-secret-change-me-0123456789abcdef

# Acepta tokens sin sesión (npm run token:dev y las pruebas). Solo desarrollo y pruebas:
# la API no arranca con true y NODE_ENV=production (FR-T01).
AUTH_ALLOW_SESSIONLESS_TOKENS=true

# Cookie del refresh con el atributo Secure. Déjalo en true: los navegadores aceptan
# cookies Secure en http://localhost.
AUTH_COOKIE_SECURE=true

PORT=3000
